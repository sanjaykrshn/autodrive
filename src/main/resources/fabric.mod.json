{
	"schemaVersion": 1,
	"id": "sheepdog",
	"version": "${version}",
	"name": "Sheepdog",
	"description": "Sheepdog: Autonomous Livestock Herding Agent. A project focused on creating an autonomous helper that guides livestock into player-designated enclosures.",
	"authors": [
		"Sanjay Krishnan"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sheepdog/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sanjay.sheepdog.Sheepdog"
		],
		"client": [
			"com.sanjay.sheepdog.client.SheepdogClient"
		]
	},
	"mixins": [
		"sheepdog.mixins.json",
		{
			"config": "sheepdog.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
